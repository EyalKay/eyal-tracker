rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /eyal/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "eyalkay@gmail.com"
                         && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}